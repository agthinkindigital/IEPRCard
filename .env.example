# Copie os valores para o ambiente do processo PHP; este projeto não carrega arquivos .env.
APP_ENV=dev
DB_DRIVER=sqlite
# DB_SQLITE_PATH=/caminho/privado/ieprcard.sqlite

# Hosts explícitos do sistema multi-tenant; sem PLATFORM_HOSTNAME a área admin fica indisponível.
# PLATFORM_HOSTNAME=admin.ieprcard.com.br
# TENANT_BASE_DOMAIN=ieprcard.com.br

# MCP OAuth: configure uma chave aleatória de pelo menos 32 bytes codificada em Base64.
# Gere com: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# MCP_PUBLIC_BASE_URL=https://mcp.ieprcard.com.br
# MCP_OAUTH_SIGNING_KEY=
# MCP_RATE_LIMIT_PATH=/caminho/privado/ieprcard-mcp-rate
# MCP_ORIGIN_ALLOWLIST=https://app.ieprcard.com.br,https://cliente.example.com

# Perfil MySQL/MariaDB (use DB_DRIVER=mysql e configure os valores no ambiente PHP).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ieprcard
# DB_USERNAME=ieprcard
# DB_PASSWORD=

# Migração administrativa enquanto o sistema ainda usa SQLite.
# MIGRATION_SOURCE_SQLITE_PATH=/caminho/privado/ieprcard.sqlite
# MIGRATION_TARGET_HOST=localhost
# MIGRATION_TARGET_PORT=3306
# MIGRATION_TARGET_DATABASE=ieprcard_prod
# MIGRATION_TARGET_USERNAME=ieprcard_migration
# MIGRATION_TARGET_PASSWORD=
